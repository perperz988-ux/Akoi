{
  "name": "zpercraft",
  "private": true,
  "version": "0.1.0",
  "description": "ZperCraft - an original voxel sandbox survival game for Android",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:html": "npm run build && node scripts-singlefile.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/app": "6.0.2",
    "@capacitor/core": "6.2.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.0",
    "@types/three": "0.170.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
