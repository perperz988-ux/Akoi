<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="#FF2A1505" />
            <stroke android:width="1.5dp" android:color="@color/orange" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="20dp" />
            <gradient android:angle="0" android:startColor="#CC10204A" android:endColor="#CC0A0F1C" />
            <stroke android:width="1dp" android:color="#66FF7A1A" />
        </shape>
    </item>
</selector>
