<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Akoi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:colorAccent">@color/orange</item>
        <item name="android:colorPrimary">@color/blue_dark</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorHighlight">@color/orange_soft</item>
        <item name="android:popupMenuStyle">@style/AkoiPopup</item>
    </style>
    <style name="AkoiPopup" parent="android:Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup</item>
    </style>
</resources>
