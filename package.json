{
  "name": "port-solano",
  "private": true,
  "version": "0.1.0",
  "description": "Port Solano - an original open-world crime-action game for Android",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:html": "npm run build && node scripts-singlefile.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "android:sync": "npm run build && npx cap sync android",
    "android:add": "npx cap add android",
    "android:open": "npx cap open android",
    "ps5:dev": "vite trash-to-ps5 --host",
    "ps5:build": "vite build trash-to-ps5 && node trash-to-ps5/build-single.mjs",
    "pf:dev": "vite phone-factory --host",
    "pf:build": "vite build phone-factory && node phone-factory/build-single.mjs"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/screen-orientation": "^6.0.3",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.0",
    "@types/three": "0.170.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
