<Item class="StarterPlayer" referent="RBX0000000B"><Properties><string name="Name">StarterPlayer</string></Properties>
<Item class="StarterPlayerScripts" referent="RBX0000000A"><Properties><string name="Name">StarterPlayerScripts</string></Properties>
<Item class="LocalScript" referent="RBX00000008"><Properties><string name="Name">CarController</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- CarController: conduccion arcade de los coches de Port Solano.
-- Funciona con teclado (WASD / flechas), mando y joystick tactil del movil.
-- El coche "flota" a 0.25 studs sobre el suelo (raycast), asi no se atasca en bordillos.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local controls = nil
task.spawn(function()
	local ok, mod = pcall(function()
		return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
	end)
	if ok and mod then
		controls = mod:GetControls()
	end
end)

local MAX_FWD = 110 -- studs/s (aprox. km/h en el velocimetro)
local MAX_REV = 35
local ACCEL = 42
local BRAKE = 95
local DRAG = 18
local TURN = math.rad(95)
local HOVER = 1.1 -- altura del centro del chasis sobre el suelo

local conn = nil
local current = nil

local function stopDriving()
	if conn then
		conn:Disconnect()
		conn = nil
	end
	if current then
		current.lv.Enabled = false
		current.ao.Enabled = false
		current = nil
	end
	player:SetAttribute("CarSpeed", nil)
end

local function startDriving(seat)
	stopDriving()
	local model = seat.Parent
	local chassis = model and model:FindFirstChild("Chassis")
	local lv = chassis and chassis:FindFirstChild("Drive")
	local ao = chassis and chassis:FindFirstChild("Steer")
	if not (lv and ao) then
		return
	end
	local look = chassis.CFrame.LookVector
	local state = {
		lv = lv,
		ao = ao,
		speed = 0,
		yaw = math.atan2(-look.X, -look.Z),
	}
	current = state

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = false

	lv.Enabled = true
	ao.Enabled = true

	conn = RunService.Heartbeat:Connect(function(dt)
		if not chassis.Parent then
			stopDriving()
			return
		end
		local throttle, steer = 0, 0
		if controls then
			local mv = controls:GetMoveVector()
			throttle, steer = -mv.Z, mv.X
		end
		if math.abs(seat.ThrottleFloat) > math.abs(throttle) then
			throttle = seat.ThrottleFloat
		end
		if math.abs(seat.SteerFloat) > math.abs(steer) then
			steer = seat.SteerFloat
		end

		-- velocidad
		local s = state.speed
		if throttle > 0.05 then
			s = if s < 0 then s + BRAKE * dt else s + ACCEL * throttle * dt
		elseif throttle < -0.05 then
			s = if s > 0 then s - BRAKE * dt else s + ACCEL * throttle * dt
		else
			local d = DRAG * dt
			s = if math.abs(s) <= d then 0 else s - math.sign(s) * d
		end
		s = math.clamp(s, -MAX_REV, MAX_FWD)

		-- si chocamos con algo, la velocidad real manda
		local fwd = CFrame.Angles(0, state.yaw, 0).LookVector
		local actual = chassis.AssemblyLinearVelocity:Dot(fwd)
		if math.abs(s - actual) > 25 then
			s = actual
		end

		-- giro
		local grip = math.clamp(math.abs(s) / 20, 0, 1) * (1 - 0.45 * math.min(math.abs(s) / MAX_FWD, 1))
		state.yaw -= steer * TURN * grip * math.sign(s) * dt

		-- suelo / agua
		params.FilterDescendantsInstances = { model, player.Character }
		local hit = workspace:Raycast(chassis.Position + Vector3.new(0, 2, 0), Vector3.new(0, -2 - HOVER - 4, 0), params)
		local vy, fy = 0, 0
		local mass = chassis.AssemblyMass
		if hit then
			if hit.Instance == workspace.Terrain and hit.Material == Enum.Material.Water then
				s *= 1 - math.min(dt * 2, 1) -- al agua: el coche se hunde
			else
				local target = hit.Position.Y + HOVER
				vy = math.clamp((target - chassis.Position.Y) * 10, -40, 25)
				fy = mass * 400
			end
		end
		state.speed = s

		fwd = CFrame.Angles(0, state.yaw, 0).LookVector
		lv.VectorVelocity = Vector3.new(fwd.X * s, vy, fwd.Z * s)
		lv.MaxAxesForce = Vector3.new(mass * 500, fy, mass * 500)
		ao.CFrame = CFrame.Angles(0, state.yaw, 0)
		player:SetAttribute("CarSpeed", math.abs(s))
	end)
end

local function onCharacter(char)
	stopDriving()
	local hum = char:WaitForChild("Humanoid")
	hum.Seated:Connect(function(active, seat)
		if active and seat and seat:IsA("VehicleSeat") and seat:GetAttribute("PSCar") then
			startDriving(seat)
		else
			stopDriving()
		end
	end)
	hum.Died:Connect(stopDriving)
end

if player.Character then
	task.spawn(onCharacter, player.Character)
end
player.CharacterAdded:Connect(onCharacter)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX00000009"><Properties><string name="Name">HUD</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- HUD: interfaz pensada para movil. Dinero, conchas, nombre del distrito,
-- botones grandes (Coche / Trabajo), mision activa con baliza y velocimetro.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local Layout = require(ReplicatedStorage:WaitForChild("Layout"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local SpawnCar = Remotes:WaitForChild("SpawnCar")
local JobRemote = Remotes:WaitForChild("Job")
local ShellRemote = Remotes:WaitForChild("Shells")
local NotifyRemote = Remotes:WaitForChild("Notify")

local FONT = Enum.Font.FredokaOne
local GOLD = Color3.fromRGB(255, 200, 80)

local gui = Instance.new("ScreenGui")
gui.Name = "PortSolanoHUD"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local function label(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = FONT
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextStrokeTransparency = 0.4
	l.TextScaled = true
	for k, v in pairs(props) do
		l[k] = v
	end
	l.Parent = parent
	return l
end

local function corner(parent, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 12)
	c.Parent = parent
end

-- Panel de dinero / conchas (arriba a la izquierda, debajo del menu de Roblox)
local stats = Instance.new("Frame")
stats.Size = UDim2.new(0, 190, 0, 70)
stats.Position = UDim2.new(0, 12, 0, 50)
stats.BackgroundColor3 = Color3.fromRGB(15, 20, 30)
stats.BackgroundTransparency = 0.35
stats.Parent = gui
corner(stats)
local moneyLabel = label(stats, {
	Size = UDim2.new(1, -16, 0.55, 0),
	Position = UDim2.new(0, 8, 0, 4),
	TextXAlignment = Enum.TextXAlignment.Left,
	TextColor3 = Color3.fromRGB(120, 255, 140),
	Text = "$ 0",
})
local shellLabel = label(stats, {
	Size = UDim2.new(1, -16, 0.38, 0),
	Position = UDim2.new(0, 8, 0.58, 0),
	TextXAlignment = Enum.TextXAlignment.Left,
	TextColor3 = GOLD,
	Text = "Conchas 0/" .. #Layout.SHELLS,
})

local function formatMoney(n)
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return "$ " .. out
end

task.spawn(function()
	local ls = player:WaitForChild("leaderstats")
	local money = ls:WaitForChild("Dinero")
	local shells = ls:WaitForChild("Conchas")
	local function refresh()
		moneyLabel.Text = formatMoney(money.Value)
		shellLabel.Text = ("Conchas %d/%d"):format(shells.Value, #Layout.SHELLS)
	end
	money.Changed:Connect(refresh)
	shells.Changed:Connect(refresh)
	refresh()
end)

-- Nombre del distrito (aparece al cambiar de zona)
local districtLabel = label(gui, {
	Size = UDim2.new(0, 420, 0, 44),
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 50),
	Text = "",
	TextTransparency = 1,
	TextStrokeTransparency = 1,
})

-- Notificaciones
local toast = label(gui, {
	Size = UDim2.new(0, 460, 0, 34),
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 140),
	TextColor3 = Color3.fromRGB(120, 255, 140),
	Text = "",
	TextTransparency = 1,
	TextStrokeTransparency = 1,
})
local toastId = 0
local function notify(text, color)
	toastId += 1
	local id = toastId
	toast.Text = text
	toast.TextColor3 = color or Color3.fromRGB(120, 255, 140)
	toast.TextTransparency = 0
	toast.TextStrokeTransparency = 0.4
	task.delay(3, function()
		if id == toastId then
			TweenService:Create(toast, TweenInfo.new(0.6), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end
NotifyRemote.OnClientEvent:Connect(function(text)
	notify(text)
end)

-- Botones grandes (derecha, encima del boton de salto del movil)
local function bigButton(text, color, y)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0, 130, 0, 54)
	b.AnchorPoint = Vector2.new(1, 0.5)
	b.Position = UDim2.new(1, -14, 0.5, y)
	b.BackgroundColor3 = color
	b.Font = FONT
	b.TextScaled = true
	b.TextColor3 = Color3.new(1, 1, 1)
	b.TextStrokeTransparency = 0.5
	b.Text = text
	b.AutoButtonColor = true
	b.Parent = gui
	corner(b, 14)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 8)
	pad.PaddingBottom = UDim.new(0, 8)
	pad.Parent = b
	return b
end

local carButton = bigButton("Coche", Color3.fromRGB(40, 140, 230), -100)
local jobButton = bigButton("Trabajo", Color3.fromRGB(240, 140, 30), -36)

carButton.Activated:Connect(function()
	SpawnCar:FireServer()
end)

-- Mision de reparto
local jobPanel = Instance.new("Frame")
jobPanel.Size = UDim2.new(0, 380, 0, 54)
jobPanel.AnchorPoint = Vector2.new(0.5, 0)
jobPanel.Position = UDim2.new(0.5, 0, 0, 96)
jobPanel.BackgroundColor3 = Color3.fromRGB(15, 20, 30)
jobPanel.BackgroundTransparency = 0.3
jobPanel.Visible = false
jobPanel.Parent = gui
corner(jobPanel)
local jobTitle = label(jobPanel, {
	Size = UDim2.new(1, -16, 0.5, 0),
	Position = UDim2.new(0, 8, 0, 3),
	TextColor3 = Color3.fromRGB(255, 180, 70),
	Text = "",
})
local jobInfo = label(jobPanel, {
	Size = UDim2.new(1, -16, 0.42, 0),
	Position = UDim2.new(0, 8, 0.52, 0),
	Text = "",
})

local job = nil
local beacon = nil

local function clearJob()
	job = nil
	jobPanel.Visible = false
	jobButton.Text = "Trabajo"
	jobButton.BackgroundColor3 = Color3.fromRGB(240, 140, 30)
	if beacon then
		beacon:Destroy()
		beacon = nil
	end
end

jobButton.Activated:Connect(function()
	JobRemote:FireServer(if job then "cancel" else "start")
end)

JobRemote.OnClientEvent:Connect(function(kind, a, b, c, d)
	if kind == "start" then
		clearJob()
		job = { name = a, pos = b, reward = c, deadline = os.clock() + d }
		jobTitle.Text = "Entrega: " .. a .. "  ($" .. c .. ")"
		jobPanel.Visible = true
		jobButton.Text = "Cancelar"
		jobButton.BackgroundColor3 = Color3.fromRGB(170, 60, 60)
		-- baliza solo visible para ti
		beacon = Instance.new("Part")
		beacon.Name = "BalizaEntrega"
		beacon.Anchored = true
		beacon.CanCollide = false
		beacon.CanQuery = false
		beacon.CanTouch = false
		beacon.Shape = Enum.PartType.Cylinder
		beacon.Size = Vector3.new(300, 14, 14)
		beacon.CFrame = CFrame.new(b + Vector3.new(0, 150, 0)) * CFrame.Angles(0, 0, math.rad(90))
		beacon.Material = Enum.Material.Neon
		beacon.Color = Color3.fromRGB(255, 170, 40)
		beacon.Transparency = 0.55
		local bb = Instance.new("BillboardGui")
		bb.AlwaysOnTop = true
		bb.Size = UDim2.new(0, 160, 0, 40)
		bb.StudsOffsetWorldSpace = Vector3.new(0, -140, 0)
		bb.Adornee = beacon
		local t = label(bb, { Size = UDim2.fromScale(1, 1), Text = "ENTREGA", TextColor3 = Color3.fromRGB(255, 190, 70) })
		t.Name = "Text"
		bb.Parent = beacon
		beacon.Parent = workspace
		notify("Nuevo trabajo: lleva el paquete a " .. a, Color3.fromRGB(255, 190, 70))
	elseif kind == "done" then
		clearJob()
	elseif kind == "cancel" then
		clearJob()
		notify("Trabajo cancelado", Color3.fromRGB(255, 120, 120))
	end
end)

-- Velocimetro
local speedo = label(gui, {
	Size = UDim2.new(0, 220, 0, 50),
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -20),
	TextColor3 = Color3.new(1, 1, 1),
	Text = "",
	Visible = false,
})

-- Conchas: ocultar las que ya tienes y hacerlas girar
local collected = {}
local shellFolder = workspace:WaitForChild("Conchas", 60)
local function hideShell(i)
	collected[i] = true
	if not shellFolder then
		return
	end
	local p = shellFolder:FindFirstChild("Concha" .. i)
	if p then
		p.Transparency = 1
		local l = p:FindFirstChildOfClass("PointLight")
		if l then
			l.Enabled = false
		end
		local s = p:FindFirstChildOfClass("Sparkles")
		if s then
			s.Enabled = false
		end
	end
end
ShellRemote.OnClientEvent:Connect(function(kind, data)
	if kind == "state" then
		for _, i in ipairs(data) do
			hideShell(i)
		end
	elseif kind == "got" then
		hideShell(data)
	end
end)

-- Bucle de interfaz
local lastDistrict = nil
local districtTween = nil
local bob = 0
RunService.RenderStepped:Connect(function(dt)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		local pos = root.Position
		local district = Layout.districtAt(pos.X, pos.Z)
		if district ~= lastDistrict then
			lastDistrict = district
			districtLabel.Text = district.name
			districtLabel.TextColor3 = district.color
			districtLabel.TextTransparency = 0
			districtLabel.TextStrokeTransparency = 0.3
			if districtTween then
				districtTween:Cancel()
			end
			districtTween = TweenService:Create(districtLabel, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 2.5), { TextTransparency = 1, TextStrokeTransparency = 1 })
			districtTween:Play()
		end
		if job then
			local flat = Vector3.new(job.pos.X - pos.X, 0, job.pos.Z - pos.Z)
			local left = math.max(0, math.ceil(job.deadline - os.clock()))
			jobInfo.Text = ("%d m   |   %d:%02d"):format(math.floor(flat.Magnitude * 0.28), left // 60, left % 60)
			jobInfo.TextColor3 = if left > 0 then Color3.new(1, 1, 1) else Color3.fromRGB(255, 110, 110)
		end
	end

	local speed = player:GetAttribute("CarSpeed")
	if speed then
		speedo.Visible = true
		speedo.Text = ("%d km/h"):format(math.floor(speed))
	else
		speedo.Visible = false
	end

	if shellFolder then
		bob += dt
		for _, p in ipairs(shellFolder:GetChildren()) do
			local i = p:GetAttribute("Index")
			if i and not collected[i] then
				local base = Layout.SHELLS[i]
				p.CFrame = CFrame.new(base + Vector3.new(0, math.sin(bob * 2 + i) * 0.5, 0)) * CFrame.Angles(0, bob * 2, 0)
			end
		end
	end
end)
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</roblox>
